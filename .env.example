# Local PostgreSQL connection URL. For Render, use the database's Internal Database URL.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/sherubtse_lost_found

# Generate a unique random value of at least 32 characters for SESSION_SECRET.
SESSION_SECRET=replace-this-with-a-long-random-secret-before-deploying

NODE_ENV=development
# For a local PostgreSQL server, use disable. For a hosted database URL, set require.
PGSSLMODE=disable
