# Copy to .env only if you do not already have one. Never commit .env.
# Required PostgreSQL connection URL (Render: Internal Database URL).
DATABASE_URL=
# Stable cryptographically random secret, at least 32 characters.
SESSION_SECRET=
# development locally, production on Render.
NODE_ENV=
# disable for local PostgreSQL; require for hosted TLS.
PGSSLMODE=
# Optional (defaults: PORT 3000, PGPOOL_MAX 10).
PORT=
PGPOOL_MAX=
# Google Apps Script deployed HTTPS web app URL and matching server-side secret.
MAIL_WEB_APP_URL=
MAIL_WEB_APP_SECRET=
# http://localhost:3000 locally; actual HTTPS service origin on Render.
APP_BASE_URL=

# Administrator: existing, email-verified student account. Uses its current password.
# Set the exact registered email, then restart. Leave blank to disable bootstrap.
ADMIN_EMAIL=
