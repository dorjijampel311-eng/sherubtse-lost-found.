# Copy to .env only if you do not already have one. Never commit .env.
# Required PostgreSQL connection URL (Render: Internal Database URL).
DATABASE_URL=
# Stable cryptographically random secret, at least 32 characters.
SESSION_SECRET=
# development locally, production on Render.
NODE_ENV=
# disable for local PostgreSQL; require for hosted TLS.
PGSSLMODE=
# Optional (defaults: PORT 3000, PGPOOL_MAX 10).
PORT=
PGPOOL_MAX=
# Google Apps Script deployment URL: https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Use the deployed /exec endpoint, not the editor or /dev URL.
# Shared secret must match MAIL_WEB_APP_SECRET in Apps Script Script Properties.
MAIL_WEB_APP_URL=
MAIL_WEB_APP_SECRET=
# http://localhost:3000 locally; actual public HTTPS service origin on Render.
# Use only one APP_BASE_URL entry. Restart after changing environment settings.
APP_BASE_URL=

# Administrator: existing, email-verified student account. Uses its current password.
# Set the exact registered email, then restart. Leave blank to disable bootstrap.
ADMIN_EMAIL=
