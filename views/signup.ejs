<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#142238"><title>Create account | Sherubtse Lost &amp; Found</title><link rel="icon" href="/Sherubtse_logo/images.jpg"><link rel="stylesheet" href="/css/style.css"><script src="/js/app.js" defer></script></head><body><header class="site-header"><nav class="nav-wrap" aria-label="Main navigation"><a class="brand" href="/"><img src="/Sherubtse_logo/images.jpg" alt="Sherubtse College crest"><span><strong>Sherubtse</strong><small>Lost &amp; Found</small></span></a><button class="menu-toggle" aria-label="Open menu" aria-expanded="false">☰</button><div class="nav-links"><a href="/">Home</a><a href="/browse">Browse items</a><a href="/report-lost">Report lost</a><a href="/report-found">Report found</a><a href="/about">About</a></div><div class="nav-account" data-account></div></nav></header><main class="auth-layout"><section class="auth-aside"><span class="eyebrow">Sherubtse College</span><h1>Help your campus community reconnect.</h1><p>Create an account to post items and manage your own listings.</p><div class="aside-crest"><img src="/Sherubtse_logo/images.jpg" alt=""></div></section><section class="auth-panel"><span class="eyebrow eyebrow-dark">Get started</span><h2>Create your account</h2><p class="muted">For Sherubtse students. Use your matching college email.</p><form id="signup-form" class="stack-form"><div class="form-two"><label>Full name<input name="name" autocomplete="name" maxlength="100" required></label><label>Student number<input name="studentId" autocomplete="off" inputmode="numeric" pattern="[0-9]{8}" minlength="8" maxlength="8" placeholder="07240068" required></label></div><label>Email address<input name="email" placeholder="07240068.sherubtse@rub.edu.bt" pattern="[0-9]{8}\.sherubtse@rub\.edu\.bt" type="email" autocomplete="email" maxlength="254" required></label><div class="form-two"><label>Phone number<input name="phone" pattern="[+0-9][0-9 \(\)\-]{6,29}" type="tel" autocomplete="tel" maxlength="30" placeholder="+975 …" required></label><label>Course / programme<select name="course" required><option value="">Choose your course</option><option>Chemistry</option><option>Physics</option><option>DCPM</option><option>EPS</option><option>DSDA</option><option>Math</option></select></label></div><label>Year of study<select name="year" required><option value="">Choose year</option><option>Year 1</option><option>Year 2</option><option>Year 3</option><option>Year 4</option></select></label><div class="password-fields"><label>Password<input name="password" type="password" autocomplete="new-password" minlength="10" pattern="(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9\s]).{10,}" aria-describedby="password-help" required><small id="password-help">At least 10 characters, including one uppercase letter, one digit, and one special character (e.g. !, @, #). Maximum 72 UTF-8 bytes.</small></label><label>Confirm password<input name="confirmPassword" type="password" autocomplete="new-password" minlength="10" required></label></div><label class="check-line"><input name="notificationsEnabled" type="checkbox"><span>Send lost and found alerts to my registered college email inbox. You can change this in your profile.</span></label><p class="form-notice">Your name and course may appear with your listings. Your phone number is shown only on posts where you choose to share it.</p><button class="button button-navy" type="submit">Create account <span>→</span></button><p class="form-message" id="form-message" role="status"></p></form><p class="auth-switch">Already registered? <a href="/login">Log in</a></p></section></main><%- include('partials/footer') %></body></html>
