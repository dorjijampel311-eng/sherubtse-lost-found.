<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#142238"><title>Your profile | Sherubtse Lost &amp; Found</title><link rel="icon" href="/Sherubtse_logo/images.jpg"><link rel="stylesheet" href="/css/style.css"><script src="/js/app.js" defer></script></head><body><header class="site-header"><nav class="nav-wrap" aria-label="Main navigation"><a class="brand" href="/"><img src="/Sherubtse_logo/images.jpg" alt="Sherubtse College crest"><span><strong>Sherubtse</strong><small>Lost &amp; Found</small></span></a><button class="menu-toggle" aria-label="Open menu" aria-expanded="false">☰</button><div class="nav-links"><a href="/">Home</a><a href="/browse">Browse items</a><a href="/report-lost">Report lost</a><a href="/report-found">Report found</a><a class="active" href="/my-items" data-auth-link>My posts</a><a href="/about">About</a></div><div class="nav-account" data-account></div></nav></header><main class="page-main form-page"><section class="form-intro"><span class="eyebrow eyebrow-dark">Your campus account</span><h1>Make yourself at home.</h1><p>Keep your contact details up to date and choose the notifications you receive.</p></section><form id="profile-form" class="report-panel"><img id="profile-photo" class="profile-photo" alt="Your profile photo" hidden><div class="form-two"><label>Student number<input id="profile-student" readonly aria-readonly="true"></label><label>College email<input id="profile-email" readonly aria-readonly="true"></label></div><p class="muted">Your student number and college email are permanent.</p><label>Display name<input name="name" maxlength="100" autocomplete="name" required></label><div class="form-two"><label>Course / programme<select name="course" required><option value="">Choose your course</option><option>Chemistry</option><option>Physics</option><option>DCPM</option><option>EPS</option><option>DSDA</option><option>Math</option></select></label><label>Year of study<select name="year" required><option>Year 1</option><option>Year 2</option><option>Year 3</option><option>Year 4</option></select></label></div><label>Phone number<input name="phone" type="tel" maxlength="30" pattern="[+0-9][0-9 \(\)\-]{6,29}" required></label><label class="file-field">Profile photo (optional)<input name="photo" type="file" accept="image/jpeg,image/png,image/webp"><small>JPG, PNG or WebP, up to 30 MB.</small></label><label class="check-line"><input name="notificationsEnabled" type="checkbox"><span>Send lost and found alerts to my registered college email inbox.</span></label><p class="form-notice">Your phone number is public on new listings. Older listings keep their saved sharing settings. Your college email is visible to signed-in students on your posts.</p><button type="submit" class="button button-navy">Save profile</button><p id="form-message" class="form-message" role="status"></p></form></main><%- include('partials/footer') %></body></html>
