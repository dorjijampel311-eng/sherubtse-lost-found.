<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#142238"><title>Admin | Sherubtse Lost &amp; Found</title><link rel="icon" href="/Sherubtse_logo/images.jpg"><link rel="stylesheet" href="/css/style.css"><script src="/js/app.js" defer></script></head><body><header class="site-header"><nav class="nav-wrap" aria-label="Main navigation"><a class="brand" href="/"><img src="/Sherubtse_logo/images.jpg" alt="Sherubtse College crest"><span><strong>Sherubtse</strong><small>Lost &amp; Found</small></span></a><button class="menu-toggle" aria-label="Open menu" aria-expanded="false">☰</button><div class="nav-links"><a href="/">Home</a><a href="/browse">Browse items</a><a href="/report-lost">Report lost</a><a href="/report-found">Report found</a><a class="active" href="/my-items" data-auth-link>My posts</a><a href="/about">About</a></div><div class="nav-account" data-account></div></nav></header><main class="page-main"><section class="page-intro"><span class="eyebrow eyebrow-dark">Administrator access</span><h1>Campus board overview</h1><p>Manage student listings and review private feedback. This area is available only to authorized administrators.</p></section><div id="admin-overview" class="admin-overview" aria-live="polite">Loading overview...</div><p id="admin-message" class="form-message" role="status"></p><section class="admin-section"><h2>Student feedback</h2><div id="admin-feedback" class="admin-review-grid" aria-live="polite"><p class="empty-state">Loading feedback...</p></div></section><section class="admin-section"><h2>Manage listings</h2><p class="muted">Search by title or listing ID. Includes lost, found and returned posts.</p><form id="admin-search-form" class="admin-search"><label for="admin-listing-search" class="muted">Find a listing</label><input id="admin-listing-search" type="search" maxlength="120" placeholder="Item title or listing ID"><button type="submit" class="button button-small button-navy">Search</button></form><div id="admin-listings" class="admin-review-grid" aria-live="polite"><p class="empty-state">Loading listings...</p></div><button type="button" id="admin-more" class="button button-small button-navy" hidden>Load more listings</button></section></main><dialog id="admin-edit-dialog" class="admin-edit-dialog" aria-labelledby="admin-edit-heading"><div class="admin-edit-header"><h2 id="admin-edit-heading">Edit listing</h2><button type="button" id="admin-edit-close" class="button button-small" aria-label="Close listing editor">Close</button></div><form id="admin-edit-form" class="report-panel"><label>Item title<input name="title" maxlength="120" required></label><div class="form-two"><label>Report type<select name="kind" required><option value="lost">LOST</option><option value="found">FOUND</option></select></label><label>Category<select name="category" required><option>Electronics</option><option>ID cards &amp; wallets</option><option>Bags</option><option>Books &amp; notes</option><option>Keys</option><option>Clothing</option><option>Sports equipment</option><option>Other</option></select></label></div><label>Description<textarea name="description" rows="4" maxlength="1000" required></textarea></label><div class="form-two"><label>Location<input name="location" maxlength="120" required></label><div class="date-field"><label for="admin-date-display">Date lost / found</label><div class="date-control" data-date-format="dmy"><input id="admin-date-display" data-date-display type="text" placeholder="DD/MM/YYYY" maxlength="10" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" required><span class="date-picker-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg></span><input name="itemDate" type="date" class="date-native" aria-label="Choose listing date from calendar"></div></div></div><img id="admin-current-photo" class="admin-current-photo" alt="Current listing photo" hidden><label class="file-field">Replace photo (optional)<input name="photo" type="file" accept="image/jpeg,image/png,image/webp"><small>JPG, PNG or WebP, up to 30 MB. Leave empty to keep the current photo.</small></label><label class="check-line"><input name="removePhoto" type="checkbox"><span>Remove the current photo</span></label><p class="form-notice">The post owner and any scheduled return-deletion date remain unchanged. Saving an edit does not send a new found-item notification.</p><button type="submit" class="button button-navy">Save changes</button><p id="admin-edit-message" class="form-message" role="status"></p></form></dialog><%- include('partials/footer') %></body></html>
